# App
APP_NAME=TalentScout AI 3.0
ENV=development
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Data provider: demo | supabase
DATA_PROVIDER=demo

# AI provider: demo | groq
AI_PROVIDER=demo

# Supabase (only needed if DATA_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Groq (only needed if AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# CORS
FRONTEND_ORIGIN=http://localhost:5173
